# ==============================================================================
# Dracovion Technologies — Environment Variable Template
# Copy this to .env and fill in your real values.
# NEVER commit a .env file with real secrets.
# ==============================================================================

NODE_ENV=production
PORT=5000

# Your production frontend domain (no trailing slash)
CLIENT_URL=https://dracovion.com
# Optional comma-separated additional allowed CORS/OAuth origins (e.g. preview domains)
CORS_ORIGINS=

# MongoDB Atlas connection string
# Get from: atlas.mongodb.com → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dracovion_technologies?retryWrites=true&w=majority

# Session security — MUST be a unique 128-char random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_128_CHAR_RANDOM_STRING
SESSION_NAME=dracovion.sid
SESSION_MAX_AGE_MS=2592000000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Platform owner bootstrap (used only on first database seed)
INITIAL_OWNER_EMAIL=president@dracovion.com
INITIAL_OWNER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
INITIAL_OWNER_NAME=Platform President & Owner

# Super Admin (Gausik Srinivasan)
SUPER_ADMIN_EMAIL=gausik@dracovion.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPER_ADMIN_NAME=Gausik Srinivasan

# CEO & Lead Engineer initial passwords (used only on first database seed)
CEO_EMAIL=ceo@dracovion.com
CEO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
INITIAL_EMPLOYEE_EMAIL=employee@dracovion.com
INITIAL_EMPLOYEE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Gmail SMTP — create App Password at:
# myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_USER=dracoviontechnology@gmail.com
GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD

# Google OAuth 2.0 — get from console.cloud.google.com
# Update Authorized redirect URIs to your backend callback URL
GOOGLE_CLIENT_ID=520665328147-vi2897fm1f0ud6qki6726cmfg3in8mhj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_SECRET
GOOGLE_CALLBACK_URL=https://dracovion-backend.onrender.com/api/v1/auth/client/google/callback

# GitHub OAuth (optional — leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://dracovion-backend.onrender.com/api/v1/auth/client/github/callback

# File uploads
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=15728640

# Business metadata
BUSINESS_NAME=Dracovion Technologies
BUSINESS_TAGLINE=Technology Without Limits.
BUSINESS_EMAIL=dracoviontechnology@gmail.com
BUSINESS_PHONE=+91 9489832249
BUSINESS_GITHUB=https://github.com/dracovion-technology
BUSINESS_INSTAGRAM=https://www.instagram.com/dracovion_technologies?hvrq=MWxuaXdtZ2tsYjdhNQ==
BUSINESS_ADDRESS_STATE=Tamil Nadu
BUSINESS_ADDRESS_COUNTRY=India
BUSINESS_GST_REGISTERED=false
BUSINESS_GSTIN=
BUSINESS_PAN=
DEFAULT_CURRENCY=INR
